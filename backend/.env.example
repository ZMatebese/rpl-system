# Copy to .env and adjust. All optional in development.
PORT=4000
# REQUIRED in production — the server refuses to start with the default.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=2h
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:5173
# UPLOAD_DIR must stay outside any statically served directory.
# UPLOAD_DIR=./uploads
# DB_PATH=./data/rpl.db
SEED_ON_START=true

# The single administrator. Only `npm run seed:admin` (or a server start with
# these set) grants the ADMINISTRATOR role; no API route can. Run seed:admin
# again with a new ADMIN_PASSWORD to recover a lost password.
# Wrap the password in double quotes: an unquoted # starts a comment in .env.
ADMIN_EMAIL=
ADMIN_PASSWORD=""
ADMIN_FIRST_NAME=
ADMIN_SURNAME=
# Demo assessor/moderator/applicant accounts (never created in production).
SEED_DEMO_USERS=true
