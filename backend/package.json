{
  "name": "rpl-backend",
  "version": "1.0.0",
  "description": "RPL Application and Assessment Management System - API",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning src/server.js",
    "dev": "node --no-warnings=ExperimentalWarning --watch src/server.js",
    "seed": "node --no-warnings=ExperimentalWarning src/db/seed.js",
    "test": "node scripts/check-route-coverage.mjs && vitest run",
    "test:watch": "vitest",
    "test:routes": "node scripts/check-route-coverage.mjs",
    "seed:admin": "node --no-warnings=ExperimentalWarning src/db/seedAdmin.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  }
}
